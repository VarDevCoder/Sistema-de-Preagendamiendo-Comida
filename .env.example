# =============================================================================
# Base de datos (PostgreSQL)
# =============================================================================
# Local (docker compose up -d): ambas URLs apuntan a la misma base.
# Neon (producción / previews de Vercel):
#   DATABASE_URL → cadena "Pooled connection" (host con -pooler), la usa la app.
#   DIRECT_URL   → cadena directa (sin -pooler), la usa `prisma migrate`.
DATABASE_URL="postgresql://app:app@localhost:5432/prepago"
DIRECT_URL="postgresql://app:app@localhost:5432/prepago"
# Máximo de conexiones por instancia (serverless: mantener bajo)
DATABASE_POOL_MAX=5

# =============================================================================
# Auth.js (se usa desde la Fase 2)
# =============================================================================
# Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=""
# Solo fuera de Vercel (ej. `next start` local): confiar en el host de la request
AUTH_TRUST_HOST=true
# Opcional: login con Google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# =============================================================================
# Pagos (Fase 4)
# =============================================================================
# mock | bancard | pagopar
PAYMENT_PROVIDER="mock"
# Secreto para firmar/verificar webhooks del proveedor mock
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"

# =============================================================================
# Tareas programadas (Vercel Cron)
# =============================================================================
# Vercel envía "Authorization: Bearer $CRON_SECRET" a las rutas /api/cron/*
CRON_SECRET=""

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Muestra las cuentas de prueba del seed en /ingresar (desarrollo y previews; NO en producción)
SHOW_DEMO_ACCOUNTS=true

# =============================================================================
# Notificaciones y PWA (Fase 8) — ver docs/fase-8-notificaciones-pwa.md
# =============================================================================
# Email: console | resend | none. Si se deja vacío: "resend" cuando están
# RESEND_API_KEY y EMAIL_FROM; si no, "console" en desarrollo y "none" en producción.
EMAIL_PROVIDER=""
# Resend (https://resend.com): API key y remitente de un dominio verificado.
RESEND_API_KEY=""
EMAIL_FROM="Prepago <avisos@tu-dominio.com.py>"
# Web push (VAPID). Generar con: npm run vapid:generate
# Sin las tres variables del servidor, push queda deshabilitado (sin errores).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@tu-dominio.com.py"
# Misma clave pública, expuesta al navegador (opcional: el servidor ya la pasa a la página).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Registrar el service worker también en `next dev` (por defecto solo en producción).
NEXT_PUBLIC_SW_IN_DEV=false
